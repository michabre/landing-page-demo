---
import * as pricing from './pricing.md'
import PriceComparisonTool from "./PriceComparisonTool"
---
<PriceComparisonTool options={pricing.frontmatter.pricing_options} client:visible />

<style>
  .card-tag {
  z-index: 9;
  top: -32px;
  left: 50%;
  right: 50%;
}
.card-type {
  width: 100%;
  border-bottom: 1px dashed #11181C;
  padding-bottom: 0.75rem;
}
.selected {
  border: 3px solid hotpink;
  scale: 1.07;
}
</style>
